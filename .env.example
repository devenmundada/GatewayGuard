# Copy to .env for local development. Never commit .env.

# Database (docker-compose maps PostgreSQL to 5433 on your machine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gatewayguard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT. Local development works without it; ENVIRONMENT=production REFUSES to start unless
# this is a random value of 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = ignore the header (safe default; clients can forge it).
TRUSTED_PROXY_COUNT=0
